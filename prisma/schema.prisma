// Prisma schema — Perfecthous
// Postgres draait lokaal of op Supabase/Neon; zie README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Beheerders van het admin-paneel. Wachtwoorden zijn bcrypt-hashes.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | editor
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

/// Een dienst. `slug` is de route: /diensten/[slug].
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  /// Korte omschrijving voor overzichtskaarten
  excerpt     String
  /// Intro-alinea bovenaan de detailpagina
  intro       String
  /// Wat we doen — één regel per bullet, gescheiden door \n
  bullets     String
  /// Iconnaam uit components/icons.tsx
  icon        String   @default("hammer")
  image       String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  /// Vertalingen voor en/ar: { en: { title, excerpt, intro, bullets, faqs[] }, ar: {...} }
  translations Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]
  faqs        ServiceFaq[]

  @@index([order])
}

/// Veelgestelde vraag per dienst (voor FAQ-schema).
model ServiceFaq {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int     @default(0)

  @@index([serviceId])
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  location    String   @default("Vlissingen")
  year        Int?
  summary     String
  description String
  coverImage  String
  /// Extra galerijfoto's, één pad per regel
  gallery     String   @default("")
  beforeImage String?
  afterImage  String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  /// Vertalingen voor en/ar: { en: { title, category, summary, description }, ar: {...} }
  translations Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([featured])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  city      String   @default("Vlissingen")
  rating    Int      @default(5)
  body      String
  service   String?
  published Boolean  @default(true)
  order     Int      @default(0)
  /// Vertalingen voor en/ar: { en: { body, service }, ar: {...} }
  translations Json?
  createdAt DateTime @default(now())
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  /// Inhoud als Markdown (subset: koppen, alinea's, lijsten, vet, links)
  content     String
  coverImage  String?
  category    String    @default("Tips")
  /// Vertalingen voor en/ar: { en: { title, excerpt, content, category }, ar: {...} }
  translations Json?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// Offerteaanvraag vanaf /offerte
model QuoteRequest {
  id          String   @id @default(cuid())
  reference   String   @unique
  name        String
  email       String
  phone       String
  city        String?
  serviceSlug String?
  serviceName String?
  description String
  startDate   String?
  budget      String?
  contactPref String   @default("telefoon") // telefoon | email | whatsapp
  /// Geüploade foto's, één pad per regel
  photos      String   @default("")
  status      String   @default("new") // new | in_progress | done | spam
  notes       String?
  source      String   @default("website")
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Contactformulier op /contact
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new")
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([status])
}

/// Rate limiting zonder externe dienst (per IP-hash + actie).
model RateLimit {
  id        String   @id @default(cuid())
  key       String
  count     Int      @default(0)
  expiresAt DateTime

  @@unique([key])
  @@index([expiresAt])
}
