# De document root van dit (sub)domein is de repo zelf. De kant-en-klare site
# staat in plesk-site/, dus elke aanvraag wordt daarnaartoe gestuurd. Daardoor
# werkt de site meteen na een git pull: geen build, geen Node, en de document
# root hoeft niet verzet te worden. Omdat niets buiten plesk-site/ geserveerd
# wordt, is broncode als /server.js ook niet meer te downloaden.
#
# Bewust geen `RewriteCond %{DOCUMENT_ROOT}/… -f`-test: op LiteSpeed/Plesk is
# %{DOCUMENT_ROOT} niet betrouwbaar, en dan valt élke aanvraag terug op de
# startpagina (site zonder CSS, JS en foto's).
#
# Paginapaden gaan rechtstreeks naar de index.html van die map. Zonder dat doet
# de server er een 301 bij en staat `/plesk-site/nl/` in de adresbalk.
#
# Werkt de hosting met nginx in plaats van Apache/LiteSpeed, dan leest deze
# server dit bestand niet. Zet dan in Plesk het document root op
# `…/perfecthous/plesk-site` (zie DEPLOY.md, sectie 0).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let's Encrypt leest zijn uitdaging uit de webroot; niet onderscheppen.
  RewriteRule ^\.well-known/ - [L]

  # Nooit doorsturen naar onszelf (voorkomt een lus).
  RewriteCond %{REQUEST_URI} !^/plesk-site/

  # Startpagina.
  RewriteRule ^$ plesk-site/index.html [L]

  # Paginapad zonder bestandsextensie: de index.html van die map.
  # /nl → plesk-site/nl/index.html, /nl/diensten/ → plesk-site/nl/diensten/index.html
  RewriteCond %{REQUEST_URI} !^/plesk-site/
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*?)/?$ plesk-site/$1/index.html [L]

  # Bestandspad (heeft een extensie): hetzelfde bestand in plesk-site/.
  # Bestaat het daar niet, dan geeft de server de 404 uit plesk-site/.htaccess.
  RewriteCond %{REQUEST_URI} !^/plesk-site/
  RewriteRule ^(.*)$ plesk-site/$1 [L]
</IfModule>
