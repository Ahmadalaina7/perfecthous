# Kopieer dit bestand naar .env en vul de waarden in.
#   cp .env.example .env
# AUTH_SECRET maak je met: openssl rand -base64 32
# scripts/serve.sh doet dit automatisch als .env ontbreekt.

# ---------- Verplicht ----------
DATABASE_URL="postgresql://perfecthous:perfecthous@localhost:5432/perfecthous"
AUTH_SECRET="vervang-dit-door-een-lange-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_EMAIL="beheer@perfecthous.nl"
ADMIN_PASSWORD="WijzigDitWachtwoord123!"

# ---------- E-mail (optioneel) ----------
# Zonder RESEND_API_KEY worden mails naar de console gelogd.
RESEND_API_KEY=""
MAIL_FROM="Perfecthous <offerte@perfecthous.nl>"
MAIL_TO="info@perfecthous.nl"

# ---------- Spambeveiliging (optioneel) ----------
# Leeg = alleen honeypot + rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- Bedrijfsgegevens ----------
# Placeholders tussen blokhaken worden letterlijk op de site getoond
# tot ze zijn ingevuld.
NEXT_PUBLIC_COMPANY_PHONE="+31616298837"
NEXT_PUBLIC_COMPANY_PHONE_DISPLAY="06 1629 8837"
NEXT_PUBLIC_COMPANY_EMAIL="info@perfecthous.nl"
NEXT_PUBLIC_WHATSAPP="31616298837"
NEXT_PUBLIC_ADDRESS_STREET="Schuitvaartgracht 85"
NEXT_PUBLIC_ADDRESS_CITY="Vlissingen"
NEXT_PUBLIC_ADDRESS_ZIP="4382 GJ"
NEXT_PUBLIC_KVK="[KvK-nummer]"
